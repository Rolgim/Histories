{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Historical region",
  "type": "object",
  "required": [
    "id",
    "name",
    "snapshots"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string"
    },
    "snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "note",
          "geometry",
          "territory",
          "religion",
          "language",
          "ethnicity"
        ],
        "properties": {
          "from": {
            "type": "integer",
            "minimum": 700,
            "maximum": 1400
          },
          "to": {
            "type": "integer",
            "minimum": 700,
            "maximum": 1400
          },
          "note": {
            "type": "string"
          },
          "geometry": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          },
          "territory": {
            "type": "string"
          },
          "religion": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "ethnicity": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}